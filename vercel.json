{
  "functions": {"api/index.js": {"maxDuration": 300}},
  "rewrites": [{"source": "/api/:path*", "destination": "/api/index.js"}],
  "crons": [
    {"path": "/api/cron/watch", "schedule": "0 2 * * *"},
    {"path": "/api/cron/archive", "schedule": "*/10 * * * *"},
    {"path": "/api/cron/gmail", "schedule": "*/5 * * * *"}
  ]
}
